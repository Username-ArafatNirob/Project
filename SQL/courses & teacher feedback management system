-- STUDENT TABLE
CREATE TABLE student (
    st_id NUMBER PRIMARY KEY,
    name VARCHAR2(50)
);

-- TEACHER TABLE
CREATE TABLE teacher (
    teacher_id NUMBER PRIMARY KEY,
    name VARCHAR2(50)
);

-- COURSE TABLE
CREATE TABLE course (
    course_id NUMBER PRIMARY KEY,
    course_name VARCHAR2(50)
);

-- ASSIGNED TEACHER TABLE
CREATE TABLE assigned_teacher (
    course_id NUMBER,
    teacher_id NUMBER,
    PRIMARY KEY (course_id, teacher_id),
    FOREIGN KEY (course_id) REFERENCES course(course_id),
    FOREIGN KEY (teacher_id) REFERENCES teacher(teacher_id)
);

-- FEEDBACK TABLE
CREATE TABLE course_feedback (
    st_id NUMBER,
    course_id NUMBER,
    course_rating NUMBER(1),
    teacher_id NUMBER,
    teacher_rating NUMBER(1),
    PRIMARY KEY (st_id, course_id, teacher_id),
    FOREIGN KEY (st_id) REFERENCES student(st_id),
    FOREIGN KEY (course_id) REFERENCES course(course_id),
    FOREIGN KEY (teacher_id) REFERENCES teacher(teacher_id),
    CHECK (course_rating BETWEEN 1 AND 5),
    CHECK (teacher_rating BETWEEN 1 AND 5)
);

