------------------------------------------------------------
-- 1. AVERAGE RATING OF EACH COURSE
------------------------------------------------------------
SELECT c.course_id,
       c.course_name,
       AVG(f.course_rating) AS avg_course_rating
FROM course c
JOIN course_feedback f ON c.course_id = f.course_id
GROUP BY c.course_id, c.course_name;


------------------------------------------------------------
-- 2. BEST COURSE BY RATING
------------------------------------------------------------
SELECT *
FROM (
    SELECT c.course_id,
           c.course_name,
           AVG(f.course_rating) AS avg_course_rating
    FROM course c
    JOIN course_feedback f ON c.course_id = f.course_id
    GROUP BY c.course_id, c.course_name
    ORDER BY avg_course_rating DESC
)
WHERE ROWNUM = 1;


------------------------------------------------------------
-- 3. LOWEST COURSE BY RATING
------------------------------------------------------------
SELECT *
FROM (
    SELECT c.course_id,
           c.course_name,
           AVG(f.course_rating) AS avg_course_rating
    FROM course c
    JOIN course_feedback f ON c.course_id = f.course_id
    GROUP BY c.course_id, c.course_name
    ORDER BY avg_course_rating ASC
)
WHERE ROWNUM = 1;


------------------------------------------------------------
-- 4. BEST TEACHER IN EACH COURSE
------------------------------------------------------------
SELECT *
FROM (
    SELECT c.course_id,
           c.course_name,
           t.teacher_id,
           t.name AS teacher_name,
           AVG(f.teacher_rating) AS avg_teacher_rating,
           ROW_NUMBER() OVER (
               PARTITION BY c.course_id 
               ORDER BY AVG(f.teacher_rating) DESC
           ) rn
    FROM course_feedback f
    JOIN course c ON f.course_id = c.course_id
    JOIN teacher t ON f.teacher_id = t.teacher_id
    GROUP BY c.course_id, c.course_name, t.teacher_id, t.name
)
WHERE rn = 1;


------------------------------------------------------------
-- 5. OVERALL BEST TEACHER (ALL COURSES COMBINED)
------------------------------------------------------------
SELECT *
FROM (
    SELECT t.teacher_id,
           t.name AS teacher_name,
           c.course_name,
           AVG(f.teacher_rating) AS avg_teacher_rating
    FROM course_feedback f
    JOIN teacher t ON f.teacher_id = t.teacher_id
    JOIN course c ON f.course_id = c.course_id
    GROUP BY t.teacher_id, t.name, c.course_name
    ORDER BY avg_teacher_rating DESC
)
WHERE ROWNUM = 1;

